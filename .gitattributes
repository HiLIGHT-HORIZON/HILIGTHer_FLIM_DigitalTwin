# Auto-detect text files and perform LF normalization
* text=auto

# Python Specifics
*.py text diff=python
*.ipynb text
*.requirements.txt text
*.bat text
*.sh text eol=lf

# Web / Frontend Specifics (Vite/React/JS/TS)
*.js text
*.jsx text
*.ts text
*.tsx text
*.html text
*.css text
*.scss text
*.json text
*.yaml text
*.yml text
*.svg text

# Deep Learning & Large Data (Treat as binary even if tracked)
# Using Git LFS for large model files
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx binary
*.h5 binary
*.nc binary
*.csv text

# Legacy / MATLAB Specifics
# MATLAB files are mostly kept in the /legacy directory now
*.m text diff=matlab
*.mlapp binary
*.mat binary
*.fig binary
*.slx binary
*.mdl binary
*.mex* binary
*.p binary

# Documentation
*.md text
*.txt text
*.xml text
*.pdf binary
