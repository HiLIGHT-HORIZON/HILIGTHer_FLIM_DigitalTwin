<deployment-project plugin="plugin.apptool" plugin-version="1.0">
  <configuration build-checksum="" file="${PROJECT_ROOT}\HILIGHT_FLIM.prj" location="${PROJECT_ROOT}" name="HILIGHT_FLIM" target="target.mlapps" target-name="Package App">
